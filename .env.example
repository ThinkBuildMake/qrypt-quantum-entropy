# Placeholders only. Real values go in your shell, a local .env (git-ignored) or Render's environment store.
APP_ENV=dev                       # dev | staging | prod; APP_PROFILE is the same setting and wins
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/qrypt
LOG_LEVEL=INFO
LOG_FILE=logs/server.log
MCP_CLIENT_KEY=                   # client key the MCP server is launched with
PER_CALL_MAX_BYTES=1024
POOL_LOW_MARK_BYTES=32768
POOL_HIGH_MARK_BYTES=131072
TOKEN_EXPIRY_DEFAULT_SECONDS=600
TOKEN_EXPIRY_MAX_SECONDS=86400
RATE_LIMIT_WINDOW_SECONDS=600     # failed-redemption window per owner (AZ-6)
RATE_LIMIT_LOCK_TIMEOUT_MS=2000   # longest a /verify waits behind other attempts for one owner before a 503
RATE_LIMIT_MAX_FAILURES=5         # failures allowed per owner in the window
QRYPT_BASE_URL=https://api-eus.qrypt.com
QRYPT_TIMEOUT_SECONDS=5
QRYPT_API_KEY=                    # Entropy-service access token (never commit a value); QRYPT_API_TOKEN also accepted
PEPPER=                           # server-side secret keying token hashes (TOKEN_PEPPER also accepted); the MCP server refuses to start without it
KEY_HASH_SECRET=                  # server-side secret that hashes client keys; required
# MCP_SERVER_PASSWORD=            # database role passwords, applied by scripts/set_role_passwords.py
# HTTP_SERVICE_PASSWORD=
# BACKUP_PASSWORD=
# Backup job and restore drill (docs/BACKUP.md), read by scripts/backup.py, not by the servers:
# BACKUP_URL=postgresql://backup:PASSWORD@localhost:5432/qrypt   # the read-only backup role
# BACKUP_AGE_RECIPIENT=age1...      # public key; or commit it as backup/age-recipient.txt
# AGE_IDENTITY=                     # path of the offline private key, restore drill only
