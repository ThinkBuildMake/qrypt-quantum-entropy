# Placeholders only. Real values go in your shell, a local .env (git-ignored) or Render's environment store.
APP_ENV=dev                       # dev | staging | prod
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/qrypt
LOG_LEVEL=INFO
LOG_FILE=logs/server.log
MCP_CLIENT_KEY=                   # client key the MCP server is launched with
PER_CALL_MAX_BYTES=1024
QRYPT_API_TOKEN=                  # Entropy-service access token (never commit a value)
# TOKEN_PEPPER=                   # later stories
# KEY_HASH_SECRET=                # later stories
