{
  "about": "EV-1: the 15 golden prompts. A case passes when the agent makes exactly one tool call, the tool is `tool`, every rule holds on its arguments and the server accepts the call. Rule kinds: eq (equal), match (regex that must match the whole argument), range ([low, high], inclusive), absent (the argument must not be sent).",
  "cases": [
    {"id": "G01", "prompt": "issue a one-time reset code for user 42 that expires in 10 minutes", "tool": "generate_token",
     "rules": [{"arg": "kind", "eq": "otp_6"}, {"arg": "owner", "match": "(?i)user[-_ ]?42|42"}, {"arg": "expiry_seconds", "range": [540, 660]}]},
    {"id": "G02", "prompt": "I need a one-time code so a customer can log in", "tool": "generate_token",
     "rules": [{"arg": "kind", "eq": "otp_6"}]},
    {"id": "G03", "prompt": "make a 6-digit code for alice@example.com that is good for 5 minutes", "tool": "generate_token",
     "rules": [{"arg": "kind", "eq": "otp_6"}, {"arg": "owner", "match": "(?i)alice@example\\.com"}, {"arg": "expiry_seconds", "eq": 300}]},
    {"id": "G04", "prompt": "new API key for the billing service", "tool": "generate_token",
     "rules": [{"arg": "kind", "eq": "api_key"}]},
    {"id": "G05", "prompt": "I need an API key for the reporting job owned by team-a that expires in 1 hour", "tool": "generate_token",
     "rules": [{"arg": "kind", "eq": "api_key"}, {"arg": "owner", "match": "(?i)team[-_ ]?a"}, {"arg": "expiry_seconds", "range": [3540, 3660]}]},
    {"id": "G06", "prompt": "give me a random UUID", "tool": "generate_token",
     "rules": [{"arg": "kind", "eq": "uuid_v4"}, {"arg": "owner", "absent": true}]},
    {"id": "G07", "prompt": "give me 32 random bytes as hex", "tool": "get_random_bytes",
     "rules": [{"arg": "length", "eq": 32}, {"arg": "encoding", "eq": "hex"}]},
    {"id": "G08", "prompt": "I want 16 random bytes encoded as base64", "tool": "get_random_bytes",
     "rules": [{"arg": "length", "eq": 16}, {"arg": "encoding", "eq": "base64"}]},
    {"id": "G09", "prompt": "64 random bytes, base64 please", "tool": "get_random_bytes",
     "rules": [{"arg": "length", "eq": 64}, {"arg": "encoding", "eq": "base64"}]},
    {"id": "G10", "prompt": "8 random bytes in hex", "tool": "get_random_bytes",
     "rules": [{"arg": "length", "eq": 8}, {"arg": "encoding", "eq": "hex"}]},
    {"id": "G11", "prompt": "pick a random number between 1 and 100", "tool": "random_int",
     "rules": [{"arg": "min", "eq": 1}, {"arg": "max", "eq": 100}]},
    {"id": "G12", "prompt": "roll a die for me", "tool": "random_int",
     "rules": [{"arg": "min", "eq": 1}, {"arg": "max", "eq": 6}]},
    {"id": "G13", "prompt": "choose a random number from 1000 to 9999", "tool": "random_int",
     "rules": [{"arg": "min", "eq": 1000}, {"arg": "max", "eq": 9999}]},
    {"id": "G14", "prompt": "I need a random number between 0 and 255", "tool": "random_int",
     "rules": [{"arg": "min", "eq": 0}, {"arg": "max", "eq": 255}]},
    {"id": "G15", "prompt": "random whole number between 500 and 600, please", "tool": "random_int",
